#!/usr/bin/env bash
set -Eeuo pipefail

repo='@GITHUB_REPO@'
version='v@VERSION@'
package="linux-dev-setup-$version"
base="https://github.com/$repo/releases/download/$version"

command -v curl >/dev/null 2>&1 || { echo 'curl is required' >&2; exit 1; }
if ! command -v sha256sum >/dev/null 2>&1 && ! command -v shasum >/dev/null 2>&1; then
  echo 'sha256sum or shasum is required' >&2
  exit 1
fi

if (( $# == 0 )); then set -- --interactive; fi
needs_tty=0
for arg in "$@"; do [[ $arg != --interactive ]] || needs_tty=1; done
if (( needs_tty )) && ! { : </dev/tty; } 2>/dev/null; then
  echo 'Interactive installation requires a terminal. Use bash -s -- --help for options.' >&2
  exit 2
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
curl -fLSs --retry 3 --output "$work/$package.tar.gz" "$base/$package.tar.gz"
curl -fLSs --retry 3 --output "$work/$package.tar.gz.sha256" "$base/$package.tar.gz.sha256"
if command -v sha256sum >/dev/null 2>&1; then
  (cd "$work" && sha256sum -c "$package.tar.gz.sha256")
else
  (cd "$work" && shasum -a 256 -c "$package.tar.gz.sha256")
fi
tar -xzf "$work/$package.tar.gz" -C "$work"
if { : </dev/tty; } 2>/dev/null; then
  "$work/$package/install.sh" "$@" </dev/tty
else
  "$work/$package/install.sh" "$@"
fi
